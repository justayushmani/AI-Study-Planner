# ========================================================
# AI STUDY PLANNER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in backend/ and ai-service/ as needed.
# NEVER commit .env to version control!
# ========================================================

# -----------------
# Backend (Node.js)
# -----------------
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_study_planner?schema=public
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# -----------------
# AI Service (Python FastAPI)
# -----------------
AI_PORT=8000
# LLM Provider configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Alternative fallback models if needed: llama-3.3-70b-versatile, mixtral-8x7b-32768

# -----------------
# Frontend (Vite + React)
# -----------------
VITE_API_URL=http://localhost:5000/api
